# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/

# Training runs - these are large and regeneratable
runs/
results/

# Dataset files - these are too large for git
datasets/tibnet/JPEGImages/
datasets/tibnet/Annotations/
datasets/tibnet/yolo_format/
datasets/tibnet/*.zip
datasets/tibnet/*.tar
datasets/tibnet/*.gz

# Keep only the dataset preparation scripts and documentation
!datasets/tibnet/DOWNLOAD_INSTRUCTIONS.md
!datasets/tibnet/*.txt

# Model weights - only keep the final models in models/ directory
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.pb
*.h5

# But DO track the models we want to deploy
!models/yolo11n_drone.pt
!models/yolo11n_drone_optimized.pt
!models/README.md
!models/.gitignore

# YOLO cache files
*.cache

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Jupyter
.ipynb_checkpoints/
*.ipynb


# Training artifacts - IGNORE ALL
training/*
